# Required for Rime to be the spoken output provider.
RIME_API_KEY=

# Use the deployed region nearest to your server. See docs.rime.ai/docs/regional-endpoints.
RIME_API_URL=https://users.rime.ai/v1/rime-tts
RIME_MODEL_ID=mistv3
RIME_SPEAKER=cove
RIME_LANGUAGE=eng
RIME_AUDIO_FORMAT=audio/mpeg
RIME_SAMPLE_RATE=22050

# Server port for the local Rime proxy and fixture tool.
PORT=8787
